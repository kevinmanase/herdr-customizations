{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/HOME/.codex/skills/herdr/scripts/herdr-tab.py hook",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/HOME/.codex/skills/herdr/scripts/herdr-tab.py hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "(^|\\.)request_user_input(_async)?$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/HOME/.codex/skills/herdr/scripts/herdr-tab.py hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/HOME/.codex/skills/herdr/scripts/herdr-tab.py hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/HOME/.codex/skills/herdr/scripts/herdr-tab.py hook",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/HOME/.codex/skills/herdr/scripts/herdr-tab.py hook",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
