#!/usr/bin/env python3
"""Show a Claude session's state on its Herdr tab, and make it obvious when Kevin is needed.

    herdr-tab ask "<question for Kevin>"         ❓ he needs to answer or decide
    herdr-tab request "<what Kevin must do>"     ❗ he needs to act: log in, approve, check his phone
    herdr-tab name "<short name>"                set the name, keep the status
    herdr-tab status working|done                set the status (clears an ask)
    herdr-tab clear --approved-pane ID --approved-session ID   clear only the target Kevin approved
    herdr-tab hook <event>                       Claude Code hooks call this with the hook JSON on stdin
    herdr-tab check-jev                          ask Jev once, and say whether the Stop hook can use it

Labels read "⏳ <name>" (working), "✅ <name>" (done), or "❓ <ask> · <name>" / "❗ <ask> · <name>"
when Kevin is needed. Needing Kevin also pops a Herdr notification. His next message, or his
answer to a question dialog, clears it. A /clear resets the label to "⚪ ready", not ✅: a
checkmark reads as done, and a cleared session has done nothing. (Herdr's own screen detection
already marks Claude's dialogs blocked; a reported state doesn't override it on a live Claude
pane, so this doesn't try.) Outside Herdr it does nothing. It never fails a hook: every error
exits 0.

Jev: when nothing is flagged, the Stop hook asks Jev whether the turn's last message waits on Kevin,
so an ask the agent forgot to flag still shows. See jev_says_waiting() and jev_warning().
"""

import json
import os
import re
import subprocess
import sys
import threading
import time

WORKING, DONE, READY, QUESTION, REQUEST = "⏳", "✅", "⚪", "❓", "❗"
READY_LABEL = READY + " ready"  # a cleared tab has no task, so no name
NEEDS = {"question": QUESTION, "request": REQUEST}
SEPARATOR = " · "
HERDR = os.environ.get("HERDR_BIN_PATH") or "herdr"
ORCHESTRATOR = os.path.expanduser("~/.claude/hooks/herdr-orchestrator")
ORCHESTRATOR_LABEL = "👑 orchestrator"
# A lane lead's tab: herdr-orchestrator's LEAD mark and LANE_ID rule (a test keeps them in step).
LEAD_LABEL = re.compile(r"🧭 (lead-[a-z][a-z0-9_-]{0,26})")
JEV_URL = os.environ.get("TYPESAFE_API_URL") or "https://api.typesafe.ai/v1/systemone"
JEV_CHARS = 1500
STATE_HOME = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
JEV_FAILED = os.path.join(STATE_HOME, "herdr-tab/jev-failed")  # shared by the Claude and Codex helpers

FLAG_HOW = (
    '`~/.claude/hooks/herdr-tab ask "<question>"` for a question or decision, or '
    '`~/.claude/hooks/herdr-tab request "<what he must do>"` for something he has to do '
    "(log in, approve, check his phone)."
)
SESSION_REMINDER = (
    "You're running in a Herdr tab that Kevin watches to see which agents need him. "
    "Once you know what this task is, name the tab in a few words, led by a stage emoji: "
    '`~/.claude/hooks/herdr-tab name "🔍 login bug"`. Rename it when the work '
    "reaches a new stage. Hooks show ⏳ while you work and ✅ when you stop. Before you stop "
    "to wait on Kevin, flag it so his tab lights up: " + FLAG_HOW + " Details: the `herdr` skill."
)
TURN_REMINDER = "Herdr: if you end this turn needing Kevin, flag it first: " + FLAG_HOW


def herdr(*args, timeout=5):
    result = subprocess.run([HERDR, *args], capture_output=True, text=True, timeout=timeout)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or f"herdr {args[0]} failed")
    return json.loads(result.stdout or "{}").get("result", {})


def current_tab():
    # The pane's tab, not the inherited HERDR_TAB_ID: a moved pane keeps its old env.
    try:
        return herdr("pane", "get", os.environ["HERDR_PANE_ID"])["pane"]["tab_id"]
    except Exception:
        return os.environ.get("HERDR_TAB_ID")


def parse(label):
    """Return (status, ask, name) from a label."""
    label = label.strip()
    if label == READY_LABEL:
        return READY, "", ""
    for status in (WORKING, DONE, READY, QUESTION, REQUEST):
        if label.startswith(status):
            rest = label[len(status) :].strip()
            if status in (QUESTION, REQUEST):  # an unnamed tab's ask isn't its name
                ask, _, name = rest.partition(SEPARATOR)
                return status, ask.strip(), name.strip()
            return status, "", rest
    return None, "", label


def clean(text, limit):
    text = " ".join(str(text).replace("·", "-").split())
    return text if len(text) <= limit else text[: limit - 1].rstrip() + "…"


def render(tab, status, ask, name):
    if status in (QUESTION, REQUEST):
        label = f"{status} {ask or 'needs you'}" + (SEPARATOR + name if name else "")
    elif status == READY and not name:
        label = READY_LABEL
    else:
        label = " ".join(part for part in (status, name) if part)
    if label:
        herdr("tab", "rename", tab, label)


def read(tab):
    return parse(herdr("tab", "get", tab)["tab"].get("label") or "")


def agent_named(name):
    try:
        return herdr("agent", "get", name)["agent"]
    except Exception:
        return None


def orchestrator():
    """The orchestrator's Herdr agent (see herdr-orchestrator), or None."""
    return agent_named("orchestrator")


def take_name(name):
    """Give this pane the Herdr name `name`: the agent, or None."""
    # Herdr sees a new process as an agent about half a second after it starts; the retries cover a slow box.
    for _ in range(6):
        try:
            herdr("agent", "rename", os.environ["HERDR_PANE_ID"], name)
            return agent_named(name)
        except RuntimeError:
            time.sleep(0.5)
    return None


def reclaim_crown(name):
    """If this pane's tab (named `name`) wears the crown, take the orchestrator's name back: the agent, or None."""
    # A restart clears a pane's Herdr name but not its tab's label, so a crowned tab without the name is
    # the orchestrator coming back. (Its SessionStart used to run `ensure`, which started a spare.)
    try:
        if name == ORCHESTRATOR_LABEL:
            return take_name("orchestrator")
    except Exception:
        pass
    return None


def unnamed(name):
    """Whether Herdr says no agent has this name. A Herdr error is not an answer, so it counts as named."""
    try:
        herdr("agent", "get", name)
        return False
    except RuntimeError as error:
        return "agent_not_found" in str(error)


def reclaim_lead(name):
    """If this pane's tab (named `name`) is a lane lead's and no agent has that name, take it: the name, or None."""
    try:
        match = LEAD_LABEL.fullmatch(name)
        if not match or not unnamed(match[1]):
            return None
        # `herdr agent start lead-<lane>` names a new lead about half a second after it starts, which can be
        # after this hook runs. Give it that long before taking a name nobody else has.
        time.sleep(1)
        if unnamed(match[1]) and take_name(match[1]):
            return match[1]
    except Exception:
        pass
    return None


def orchestrator_context(agent):
    if agent and agent["pane_id"] == os.environ.get("HERDR_PANE_ID"):
        return (
            "You are the orchestrator (👑): the one session that keeps track of all the others for Kevin. "
            "Load the `herdr` skill and follow its Orchestrator section. Keep no notes: rebuild the picture "
            "each time from ticket-graph checkpoints, Linear, GitHub and the tabs."
        )
    if agent:
        return (
            "The orchestrator (👑) is the Claude session named `orchestrator`. When you merge, get blocked, "
            "finish, or start another session, SendMessage it one line."
        )
    return "No orchestrator is running in Herdr, so one is being started."


def same_clear_target(agent, pane, session, terminal):
    return (
        agent.get("agent") == "claude"
        and agent.get("pane_id") == pane
        and agent.get("terminal_id") == terminal
        and (agent.get("agent_session") or {}).get("value") == session
    )


def clear_idle(pane, session, terminal):
    settled = herdr("agent", "wait", pane, "--timeout", "30000", timeout=32)["agent"]
    current = herdr("agent", "get", pane)["agent"]
    if not same_clear_target(current, pane, session, terminal):
        return
    if current.get("agent_status") not in ("idle", "done"):
        return
    if current.get("state_change_seq") != settled.get("state_change_seq"):
        return
    if read(current["tab_id"])[0] in (QUESTION, REQUEST):
        return
    herdr("agent", "prompt", pane, "/clear")


def clear_when_done(approved_pane=None, approved_session=None):
    if not approved_pane or not approved_session:
        raise RuntimeError(
            "Clear requires Kevin's explicit approval for the identified tab and session. "
            "After approval, pass --approved-pane and --approved-session. Leaving chat open."
        )
    me = herdr("agent", "get", approved_pane)["agent"]
    terminal = me.get("terminal_id")
    if not terminal or not same_clear_target(me, approved_pane, approved_session, terminal):
        raise RuntimeError("Approved session identity no longer matches; leaving chat open")
    if read(me["tab_id"])[0] in (QUESTION, REQUEST):
        raise RuntimeError("Resolve the pending ask before clearing this session")
    subprocess.Popen(
        [
            sys.executable,
            os.path.abspath(__file__),
            "_clear-idle",
            approved_pane,
            approved_session,
            terminal,
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def forget_name():
    # A cleared session has no task, so a note meant for the old one mustn't reach it by that name:
    # it would wake with no context and redo finished work. The Herdr name goes now, before the tab
    # reads ⚪ ready. The Claude session is renamed once /clear has finished, unless the pane has
    # been named for new work by then, as `herdr-orchestrator next` does. Many sessions named `ready` is fine.
    # (It's typed in because Claude Code ignores a SessionStart hook's sessionTitle on a clear.)
    pane = os.environ["HERDR_PANE_ID"]
    herdr("agent", "rename", pane, "--clear")
    script = (
        f'sleep 2; "{HERDR}" agent get "{pane}" | jq -e ".result.agent.name == null" >/dev/null && '
        f'"{HERDR}" agent prompt "{pane}" "/rename ready" >/dev/null 2>&1'
    )
    subprocess.Popen(
        ["sh", "-c", script],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def ensure_orchestrator():
    # Detached: starting one takes longer than a hook may run.
    subprocess.Popen(
        [ORCHESTRATOR, "ensure"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def needs(kind, ask):
    tab = current_tab()
    status, old_ask, name = read(tab)
    ask = clean(ask, 48) or "needs you"
    if (status, old_ask) != (NEEDS[kind], ask):
        render(tab, NEEDS[kind], ask, name)
    who = clean(name, 40) or "An agent"
    herdr(
        "notification",
        "show",
        f"{NEEDS[kind]} {who} needs you",
        "--body",
        ask,
        "--sound",
        "request",
    )


# Not every prompt is Kevin's: SendMessage from another Claude session, a Codex report typed in with
# `herdr agent prompt`, and a finished background task's notification all arrive as prompts too.
# Only Kevin's own prompt answers his pending ask.
NOT_KEVIN = ("<cross-session-message", "Status from ", "<task-notification")


def from_kevin(payload):
    return not str(payload.get("prompt") or "").lstrip().startswith(NOT_KEVIN)


def set_status(status, clear_needs=True):
    tab = current_tab()
    current, ask, name = read(tab)
    if not clear_needs and current in (QUESTION, REQUEST):
        return
    if current != status:
        render(tab, status, "", name)


def set_name(name):
    tab = current_tab()
    status, ask, _ = read(tab)
    _, _, name = parse(name)
    render(tab, status, ask, clean(name, 60))


def typesafe_key(problems=None):
    """TYPESAFE_API_KEY, then jev.api_key in ~/.config/team-floor/config.json, then the file named by
    jev.api_key_file (relative paths start in ~/.config/team-floor), by default ~/.config/typesafe/api-key.
    Returns "" when there's no usable key, and adds what went wrong to `problems`. Keep this identical in
    herdr-orchestrator, herdr-tab and codex/skills/herdr/scripts/herdr-tab.py; tests/test_lanes.py compares them."""
    problems = [] if problems is None else problems
    folder = os.path.expanduser("~/.config/team-floor")
    key = os.environ.get("TYPESAFE_API_KEY", "").strip()
    if not key:
        jev = {}
        try:
            with open(os.path.join(folder, "config.json"), encoding="utf-8") as handle:
                jev = json.load(handle).get("jev", {})
        except FileNotFoundError:
            pass
        except Exception as error:
            problems.append(f"can't read {folder}/config.json ({type(error).__name__})")
        jev = jev if isinstance(jev, dict) else {}
        key = jev.get("api_key") if isinstance(jev.get("api_key"), str) else ""
        key = key.strip()
        named = jev.get("api_key_file")
        custom = isinstance(named, str) and bool(named)
        if named is not None and not custom:
            problems.append("jev.api_key_file in config.json must be a path")
        if not key:
            path = os.path.expanduser("~/.config/typesafe/api-key")
            if custom:
                path = os.path.join(folder, os.path.expanduser(named))
            try:
                with open(path, encoding="utf-8") as handle:
                    key = handle.read().strip()
            except FileNotFoundError:
                if custom:
                    problems.append("the file named by jev.api_key_file doesn't exist")
            except (OSError, ValueError) as error:
                problems.append(f"can't read the TypeSafe key file ({type(error).__name__})")
    if key and (" " in key or not key.isprintable()):
        problems.append("the TypeSafe key has spaces or control characters, so it isn't used")
        return ""
    return key


def jev_says_waiting(text, deadline=5):
    """Whether Jev reads `text` as ending by waiting on the reader. Sends only its last JEV_CHARS characters,
    and nothing without a TypeSafe key. Never raises: a failed call, or one that takes over `deadline` seconds
    (1 for five minutes after Jev times out), counts as no, and JEV_FAILED says why until a call succeeds. Keep
    this, ask_line and jev_warning identical in claude/hooks/herdr-tab and codex/skills/herdr/scripts/herdr-tab.py;
    tests/test_lanes.py compares them."""
    key = typesafe_key() if isinstance(text, str) and text.strip() else ""
    if not key:
        return False
    backoff = False
    try:
        if time.time() - os.path.getmtime(JEV_FAILED) < 300:
            with open(JEV_FAILED, encoding="utf-8") as handle:
                backoff = handle.read().startswith("TimeoutError")
    except (OSError, ValueError):
        pass
    if backoff:  # Jev timed out in the last five minutes: don't hold every turn end meanwhile
        deadline = min(deadline, 1)
    import urllib.request  # here, not at the top: most hook calls never reach Jev

    class NoRedirects(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *args):  # following one would send the key wherever it points
            return None

    body = {
        "state": text[-JEV_CHARS:],
        "model": "jev-latest",
        "questions": {
            "waits_on_reader": {
                "type": "noul",
                "instructions": "Does this message end by waiting on the reader before work can continue?",
                "criteria": {
                    "true": "Asks the reader a question, or for a decision, approval or action",
                    "false": "Reports results or status; nothing is needed from the reader",
                },
            }
        },
    }
    answers = []

    def ask():
        try:
            request = urllib.request.Request(
                JEV_URL,
                data=json.dumps(body).encode(),
                headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
            )
            # The timeout limits each connect and read, so a dead address gives way to the next one.
            with urllib.request.build_opener(NoRedirects).open(request, timeout=2) as response:
                noul = json.load(response)["answers"]["waits_on_reader"]["noul"]
            if type(noul) not in (int, float) or not 0 <= noul <= 1:
                raise ValueError("noul is not a probability")
            answers.append(noul >= 0.5)
        except Exception as error:
            answers.append(error)

    # The deadline covers the whole call, a slow DNS lookup included, which the timeout doesn't. A call still
    # running when it passes ends with the hook, since the thread is a daemon.
    thread = threading.Thread(target=ask, name="jev", daemon=True)
    thread.start()
    thread.join(deadline)
    answer = answers[0] if answers else TimeoutError()
    try:
        if isinstance(answer, bool):
            os.remove(JEV_FAILED)
        elif not (backoff and isinstance(answer, TimeoutError)):  # let the five minutes run out
            # The HTTP status, or the network error's own text. Never other error text: it can quote the request.
            code, reason = getattr(answer, "code", None), getattr(answer, "reason", None)
            detail = f" {code}" if isinstance(code, int) else f" ({reason})" if isinstance(reason, OSError) else ""
            os.makedirs(os.path.dirname(JEV_FAILED), exist_ok=True)
            with open(JEV_FAILED, "w", encoding="utf-8") as handle:
                handle.write(f"{type(answer).__name__}{detail} at {time.strftime('%Y-%m-%d %H:%M')}")
    except OSError:
        pass
    return answer is True


def ask_line(text):
    """The ask to show for `text`, a message Jev says waits on the reader, from the part Jev saw: the last
    sentence of its last question, else of its last plain line, else "reply needed". Code, headings, quotes
    and tables don't count, and list items count only as questions."""
    questions, plain, code, start, end = [], [], False, len(text) - JEV_CHARS, 0
    for raw in text.splitlines(keepends=True):
        end += len(raw)
        line = raw.strip()
        if line.startswith(("```", "~~~")):
            code = not code
        elif line and not code and end > start and not raw.startswith(("    ", "\t", "#", ">", "|")):
            item = re.match(r"(?:[-*+]|\d+[.)])\s+", line)
            line = re.split(r"(?<=[.!])\s+(?=[A-Z])", line[item.end() if item else 0 :].strip("*_ "))[-1]
            if line.endswith("?"):
                questions.append(line)
            elif line and not item:
                plain.append(line)
    return (questions or plain or ["reply needed"])[-1]


def jev_warning():
    """A line for Kevin when the Stop hook can't ask Jev, or "" when it can. Never raises."""
    problems = []
    if typesafe_key(problems):
        try:
            with open(JEV_FAILED, encoding="utf-8") as handle:
                why = "its last call failed: " + handle.read().strip()
        except (OSError, ValueError):
            return ""
    else:
        why = "; ".join(["no usable TypeSafe key", *problems])
    return (
        f"Herdr: Jev isn't working ({why}), so a question an agent forgets to flag won't light up its tab. "
        "See docs/setup.md in herdr-customizations."
    )


def dialog_ask(payload):
    tool = payload.get("tool_name")
    if tool == "ExitPlanMode":
        return "approve the plan"
    questions = (payload.get("tool_input") or {}).get("questions") or [{}]
    first = questions[0] if isinstance(questions[0], dict) else {}
    return first.get("question") or first.get("header") or "answer the question"


def hook(event):
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        payload = {}
    if event == "remind":  # synchronous: its output joins the turn's context
        print(TURN_REMINDER)
    elif event == "session":
        tab = current_tab()
        try:
            status, _, name = read(tab)
        except Exception:
            status, name = None, ""
        agent = orchestrator()
        reclaimed = not agent and reclaim_crown(name)
        agent = reclaimed or agent
        mine = bool(agent) and agent["pane_id"] == os.environ.get("HERDR_PANE_ID")
        context = SESSION_REMINDER + " " + orchestrator_context(agent)
        if reclaimed:
            context += (
                " A restart cleared this pane's Herdr name. This tab still wears the crown, so the hook "
                "gave the name back: you are still the orchestrator."
            )
        lead = not mine and payload.get("source") != "clear" and reclaim_lead(name)
        if lead:
            context += (
                f" This tab reads as {lead}'s and its pane had no Herdr name, so the hook gave it that name: "
                f"you are {lead}, a lane lead. Follow the `herdr` skill's Lane leads section."
            )
        output = {"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": context}}
        warning = jev_warning()
        if warning:
            output["systemMessage"] = warning
        print(json.dumps(output))
        source = payload.get("source")
        if source == "clear":  # the old task's name went with its context; the role didn't
            if not mine:
                forget_name()
            render(tab, READY, "", ORCHESTRATOR_LABEL if mine else "")
        elif source == "startup" and status in (WORKING, QUESTION, REQUEST) or source == "resume" and status == WORKING:
            # Left over from a session that ended mid-turn. A resumed session keeps its ask, and compaction,
            # which can come mid-turn, changes nothing.
            render(tab, DONE, "", name)
        if not agent:
            ensure_orchestrator()
    elif event in ("prompt", "resume"):
        set_status(WORKING, clear_needs=from_kevin(payload))
    elif event == "question":
        needs("question", dialog_ask(payload))
    elif event == "notify":
        # A question dialog also raises a generic permission notification; keep the specific ask.
        if read(current_tab())[0] not in (QUESTION, REQUEST):
            needs("request", payload.get("message") or "approve a permission prompt")
    elif event == "stop":
        # Synchronous (no "async" in the hook settings): Claude Code takes Kevin's next prompt only after this
        # returns, so Jev's answer can't land on the next turn.
        if not orchestrator():
            ensure_orchestrator()
        try:
            tab = current_tab()
            status, _, name = read(tab)
        except Exception:  # a Herdr hiccup: set_status reads again
            set_status(DONE, clear_needs=False)
            return
        if status in (QUESTION, REQUEST):  # a flagged ask already shows; Jev can't add to it
            return
        if status != DONE:
            render(tab, DONE, "", name)  # now, so the turn reads done even if the hook is cut short
        text = payload.get("last_assistant_message") or ""
        failing = os.path.exists(JEV_FAILED)
        if jev_says_waiting(text) and read(tab)[0] == DONE:  # a prompt, /clear or ask that landed meanwhile wins
            needs("question", ask_line(text))
        if not failing and os.path.exists(JEV_FAILED):  # Jev just started failing: tell Kevin now, once
            print(json.dumps({"systemMessage": jev_warning()}))


def main():
    if os.environ.get("HERDR_ENV") != "1" or len(sys.argv) < 2:
        return
    command, args = sys.argv[1], sys.argv[2:]
    if command in ("ask", "request") and args:
        needs("question" if command == "ask" else "request", " ".join(args))
    elif command == "status" and args:
        if args[0] == "question":  # older spelling of `ask`
            needs("question", " ".join(args[1:]) or "needs you")
        elif args[0] in ("working", "done"):
            set_status(WORKING if args[0] == "working" else DONE)
    elif command == "name" and args:
        set_name(" ".join(args))
    elif command == "clear":
        import argparse

        parser = argparse.ArgumentParser(prog="herdr-tab clear")
        parser.add_argument("--approved-pane")
        parser.add_argument("--approved-session")
        approved = parser.parse_args(args)
        clear_when_done(approved.approved_pane, approved.approved_session)
    elif command == "_clear-idle" and len(args) == 3:
        clear_idle(*args)
    elif command == "check-jev":  # for setup: ask Jev once and say whether the Stop hook can use it
        try:
            os.remove(JEV_FAILED)
        except OSError:
            pass
        jev_says_waiting("Should I merge it now?")
        print(jev_warning() or "Jev answered, so the Stop hook can ask it.")
    elif command == "hook" and args:
        hook(args[0])


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"herdr-tab: {error}", file=sys.stderr)
        if len(sys.argv) > 1 and sys.argv[1] != "hook":
            sys.exit(1)
    if any(thread.daemon for thread in threading.enumerate()):
        # A Jev call is still running. Skip the interpreter's teardown, which can crash under a thread that's
        # inside OpenSSL; nothing is left to clean up.
        sys.stdout.flush()
        sys.stderr.flush()
        os._exit(0)
    sys.exit(0)
