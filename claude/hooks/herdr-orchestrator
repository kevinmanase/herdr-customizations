#!/usr/bin/env python3
"""Keep the shared Claude or Codex orchestrator visible without replacing a live owner.

    herdr-orchestrator who             print the orchestrator's tab and state; exit 1 if there is none
    herdr-orchestrator claim           make the calling Claude session the orchestrator, taking the role over
    herdr-orchestrator ensure          recover only a confirmed vacant 👑 tab; defer uncertain identity
    herdr-orchestrator next [--lane L] start the next queued brief in a ⚪ ready Claude tab, or a new tab
    herdr-orchestrator route <brief>   ask Jev which lane a queued brief belongs to, and move it there
    herdr-orchestrator leads           one line per lane; start a lead where a lane is busy
    herdr-orchestrator handback <lane> run by a lead: give a quiet lane back to the orchestrator

The orchestrator is the Herdr agent named `orchestrator`. Herdr keeps agent names unique among live
agents, so there can never be two. Claiming also names its tab "👑 orchestrator", renames its Claude
session `orchestrator` (SendMessage reaches it by that name) and turns its prompt bar yellow.
A restart can clear display metadata without ending the assigned conversation. `ensure`
starts no spare while a crowned tab still runs any agent. It can recover a confirmed vacant
crowned shell, but a missing crown requires owner reconciliation rather than a new tab.
The orchestrator keeps no notes: it rebuilds its picture from ticket-graph checkpoints, Linear,
GitHub and the tabs each time.

`next` takes the first brief by name (<order>-<agent-name>.md, one self-contained brief each) from
QUEUE and from the queue of any lane that has no lead. `next --lane L` takes only from QUEUE/L/, for
that lane's lead. It exits 0 when it starts one or the queue is empty, and 3 when memory is short.
New sessions start in HERDR_WORK_DIR, or the current directory.

Lanes come from LANES, a file the team floor reads too: {"lanes": [{"id", "name", "about"}]}.
`route` asks Jev a choice question over the lane ids plus `unclear`, sending at most the
brief's last 1,500 characters, and our rules decide: probability >= 0.60 routes; 0.40 to 0.60
routes and marks the brief "lane to confirm"; anything else, `unclear`, or no Jev leaves the
brief where it is and flags Kevin. It exits 0 when it routes and 3 when Kevin has to pick.
A lane with at least LEAD_AT open briefs or sessions gets a lead: a fresh Claude session named
lead-<lane> that runs that lane's queue. When the lane is down to HANDBACK_AT open items, the
lead runs `handback`. Its conversation stays open.
"""

import contextlib
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request

NAME = "orchestrator"
CROWN = "👑"
LABEL = f"{CROWN} {NAME}"
COLOR = "yellow"
HERDR = os.environ.get("HERDR_BIN_PATH") or "herdr"
TAB = os.path.join(os.path.dirname(os.path.realpath(__file__)), "herdr-tab")  # installed side by side
STATE = os.path.expanduser("~/.local/state/orchestrator")
WORK_DIR = os.path.expanduser(os.environ.get("HERDR_WORK_DIR") or os.getcwd())
QUEUE = os.path.expanduser(os.environ.get("HERDR_FLEET_QUEUE") or "~/.cache/herdr-fleet/queue")
MIN_MB = int(os.environ.get("FLEET_MIN_MB", "1500"))
SHELL_TRIES, SHELL_WAIT = 20, 0.5  # agent starts, and seconds between them, while a new tab's shell starts
GRACE = 60  # seconds a restarted orchestrator gets to take its name back (herdr-tab's reclaim_crown)
LANES = os.path.expanduser("~/.config/team-floor/lanes.json")
LANE_ID = re.compile(r"[a-z][a-z0-9_-]{0,26}")  # so lead-<lane> is a valid Herdr agent name
UNCLEAR = "unclear"
RESERVED = {UNCLEAR, "started", "misc"}  # Jev's escape hatch, the queue's own folder, and Team Floor's catch-all row
ROUTE_AT, CONFIRM_AT = 0.60, 0.40
LEAD_AT, HANDBACK_AT = 4, 1  # open items that start a lead, and that hand the lane back
LEAD = "🧭"
FINISHED = ("🎉", "💤", "🧹")  # a session whose work is merged, parked, or done and ready to clear
JEV_URL = os.environ.get("TYPESAFE_API_URL") or "https://api.typesafe.ai/v1/systemone"
JEV_CHARS = 1500
BRIEF = (
    "You are the orchestrator: the one Claude session in Herdr that keeps track of all the others "
    "for Kevin. The previous orchestrator stopped, so this session was started to replace it. Load the "
    "`herdr` skill and follow its Orchestrator section. Coordinate, and hand the work itself to "
    "fresh sessions. Rebuild the picture from each worktree's ticket-graph checkpoint, Linear, GitHub "
    "and the tabs, then tell Kevin in a few lines what you picked up and what needs him. If Agent Wire "
    "is installed, start your task text with `role: main`."
)
LEAD_BRIEF = (
    "You are {lead}, the lead for the {name} lane ({about}). The orchestrator handed you this lane "
    "because it got busy, so its own context stays short. Load the `herdr` skill and follow its "
    "Lane leads section. Keep your tab named `{label}`. Your queue is {queue}: start each brief in "
    "a fresh session with `~/.claude/hooks/herdr-orchestrator next --lane {lane}`. Coordinate, and "
    "hand the work itself to those sessions. If Agent Wire is installed, start your task text with "
    "`role: lead lane: {lane}`. Send the orchestrator one line when something in the lane merges, "
    "gets blocked or needs Kevin, and answer its questions about the lane in detail. When the lane "
    "is down to {handback} open item, run `~/.claude/hooks/herdr-orchestrator handback {lane}`. "
    "Leave this conversation open afterwards; never clear it."
)
LANE_NOTE = (
    "\n\nThis brief is in the {lane} lane. While {lead} runs, send it your one-line updates "
    "instead of the orchestrator."
)


def herdr(*args, timeout=10):
    result = subprocess.run([HERDR, *args], capture_output=True, text=True, timeout=timeout)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or f"herdr {args[0]} failed")
    return json.loads(result.stdout or "{}").get("result", {})


def error_code(error):
    """The code of a failed herdr call's JSON error, or None."""
    try:
        return json.loads(str(error)).get("error", {}).get("code")
    except (ValueError, AttributeError):
        return None


def agent_named(name):
    """The live Herdr agent with this name, or None."""
    try:
        return herdr("agent", "get", name, timeout=5)["agent"]
    except RuntimeError as error:
        # An unavailable server is not evidence that the assigned owner exited.
        if error_code(error) == "agent_not_found":
            return None
        raise


def live():
    """The orchestrator's Herdr agent, or None."""
    return agent_named(NAME)


def who():
    agent = live()
    if not agent:
        print("no orchestrator is running")
        return 1
    label = herdr("tab", "get", agent["tab_id"])["tab"].get("label", "")
    print(f"{label} (tab {agent['tab_id']}, pane {agent['pane_id']}, {agent['agent_status']})")
    return 0


def type_into(pane, text):
    # /rename and /color run at once even while the session is busy, so this never waits on a turn.
    try:
        herdr("agent", "prompt", pane, text)
    except Exception as error:
        print(f"couldn't send {text!r} to {pane}: {error}", file=sys.stderr)


def claim():
    me = os.environ.get("HERDR_PANE_ID")
    if not me:
        print("not in a Herdr pane", file=sys.stderr)
        return 2
    old = live()
    if old and old["pane_id"] != me:
        herdr("agent", "rename", old["pane_id"], "--clear")
        herdr("tab", "rename", old["tab_id"], "✅ 💤 ex-orchestrator")
        type_into(old["pane_id"], "/rename ex-orchestrator")
        print(f"took the role over from {old['tab_id']}; tell that session with SendMessage")
    if not old or old["pane_id"] != me:
        herdr("agent", "rename", me, NAME)
    subprocess.run([TAB, "name", LABEL], check=False)
    type_into(me, f"/rename {NAME}")
    type_into(me, f"/color {COLOR}")
    print("you are the orchestrator; rebuild the picture from checkpoints, Linear, GitHub and the tabs")
    return 0


def available_mb():
    """Memory a new agent can use: MemAvailable on Linux, free + inactive pages on macOS."""
    try:
        with open("/proc/meminfo") as meminfo:
            return next(int(line.split()[1]) // 1024 for line in meminfo if line.startswith("MemAvailable"))
    except FileNotFoundError:
        out = subprocess.run(["vm_stat"], capture_output=True, text=True, check=True).stdout
        page = int(re.search(r"page size of (\d+)", out).group(1))
        kinds = ("free", "inactive", "speculative")
        pages = sum(int(re.search(rf"Pages {kind}:\s+(\d+)", out).group(1)) for kind in kinds)
        return pages * page // 2**20


def crowned_panes():
    """The panes of tabs that still wear the crown: where the orchestrator lives, or lived."""
    tabs = herdr("tab", "list")["tabs"]
    crowned = {tab["tab_id"] for tab in tabs if (tab.get("label") or "").endswith(LABEL)}
    return [pane for pane in herdr("pane", "list")["panes"] if pane["tab_id"] in crowned]


def bare_shell(pane):
    """Whether only the pane's shell runs in its foreground, so a command can be typed there."""
    info = herdr("pane", "process-info", "--pane", pane["pane_id"])["process_info"]
    return info["foreground_process_group_id"] == info["shell_pid"]


def ensure():
    if live():
        return 0
    time.sleep(GRACE)  # a restart clears the name, and the session takes it back when it starts
    os.makedirs(STATE, exist_ok=True)
    with open(os.path.join(STATE, ".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if live():  # it came back, or another session started one while we waited for the lock
            return 0
        crowned = crowned_panes()
        if any(pane.get("agent") for pane in crowned):
            return 0
        if not crowned:
            print(
                "Coordinator name/crown missing; reconcile the existing owner before starting a replacement.",
                file=sys.stderr,
            )
            return 3
        avail = available_mb()
        if avail < MIN_MB:
            herdr(
                "notification",
                "show",
                f"❗ No {NAME} in Herdr",
                "--body",
                f"Only {avail} MB free. Close a finished tab, then run ~/.claude/hooks/herdr-orchestrator ensure",
                "--sound",
                "request",
            )
            return 3
        # A dead orchestrator is replaced in its own tab, so no second crown appears beside it.
        shell = next((pane for pane in crowned if bare_shell(pane)), None)
        if shell:
            pane, tab_id = shell["pane_id"], shell["tab_id"]
            if shell.get("cwd") != WORK_DIR:
                herdr("pane", "run", pane, f"cd {WORK_DIR}")
        elif crowned:
            herdr(
                "notification",
                "show",
                f"❗ No {NAME} in Herdr",
                "--body",
                f"Coordinator identity is uncertain in {crowned[0]['tab_id']}; verify the existing owner.",
                "--sound",
                "request",
            )
            return 3
        herdr(
            "agent",
            "start",
            NAME,
            "--kind",
            "claude",
            "--pane",
            pane,
            "--timeout",
            "120000",
            "--",
            "-n",
            NAME,
            timeout=150,
        )
        type_into(NAME, f"/color {COLOR}")
        herdr("agent", "prompt", NAME, BRIEF)
        herdr(
            "notification",
            "show",
            f"{CROWN} New {NAME}",
            "--body",
            f"The last one was gone, so one started in tab {tab_id}.",
        )
    return 0


@contextlib.contextmanager
def locked(folder, name=".lock"):
    os.makedirs(folder, exist_ok=True)
    with open(os.path.join(folder, name), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def queue_lock():
    return locked(QUEUE)


def briefs_in(folder):
    try:
        return sorted(f for f in os.listdir(folder) if f.endswith(".md"))
    except FileNotFoundError:
        return []


def agent_name(brief):
    return brief[: -len(".md")].split("-", 1)[-1]


def start_in_new_tab(name, pane):
    """Start Claude in a new tab's pane, waiting while its shell is still starting."""
    for attempt in range(SHELL_TRIES):
        try:
            herdr(
                "agent", "start", name, "--kind", "claude", "--pane", pane, "--timeout", "120000", "--", "-n", name,
                timeout=150,
            )  # fmt: skip
            return
        except RuntimeError as error:
            if error_code(error) != "agent_pane_busy" or attempt == SHELL_TRIES - 1:
                raise
        time.sleep(SHELL_WAIT)


def start_session(name, label=None):
    """Start a fresh Claude session named `name`, reusing a ⚪ ready tab first. Its pane, or None if memory is short."""
    # A cleared session is already running and fresh, so reusing one costs no memory.
    ready = {t["tab_id"] for t in herdr("tab", "list")["tabs"] if t.get("label") == "⚪ ready"}
    reuse = next(
        (
            p
            for p in herdr("pane", "list")["panes"]
            if p["tab_id"] in ready
            and p.get("agent") == "claude"
            and p.get("cwd") == WORK_DIR
            and p.get("agent_status") in ("idle", "done")
        ),
        None,
    )
    if reuse:
        herdr("agent", "rename", reuse["pane_id"], name)
        type_into(name, f"/rename {name}")
        if label:
            herdr("tab", "rename", reuse["tab_id"], label)
        return reuse["pane_id"]
    avail = available_mb()
    if avail < MIN_MB:
        print(f"fleet: {avail} MB available, {MIN_MB} needed; {name} not started")
        return None
    workspace = os.environ["HERDR_WORKSPACE_ID"]
    tab = herdr("tab", "create", "--workspace", workspace, "--label", label or name, "--cwd", WORK_DIR, "--no-focus")
    pane = tab["root_pane"]["pane_id"]
    try:
        start_in_new_tab(name, pane)
    except Exception:  # the brief stays queued, so the next try opens its own tab
        with contextlib.suppress(Exception):
            herdr("tab", "close", tab["tab"]["tab_id"])
        raise
    return pane


def next_brief(*args):
    """Start the next queued brief in a fresh Claude session."""
    lane = args[1] if len(args) == 2 and args[0] == "--lane" else None
    if args and not (lane and LANE_ID.fullmatch(lane)):
        print("usage: herdr-orchestrator next [--lane <lane>]", file=sys.stderr)
        return 2
    with queue_lock():
        if lane:
            folders = [os.path.join(QUEUE, lane)]
        else:  # the main queue, then lanes that have no lead to run them
            folders = [QUEUE]
            try:
                lanes = load_lanes()
            except LanesUnreadable as error:  # an optional, shared file mustn't stop the main queue
                print(f"fleet: {error}; skipping lane queues", file=sys.stderr)
                lanes = []
            folders += [os.path.join(QUEUE, ln["id"]) for ln in lanes if not agent_named(f"lead-{ln['id']}")]
        queued = sorted((brief, folder) for folder in folders for brief in briefs_in(folder))
        if not queued:
            print("fleet: queue empty")
            return 0
        brief, folder = queued[0]
        name = agent_name(brief)
        path = os.path.join(folder, brief)
        with open(path, encoding="utf-8") as handle:
            text = handle.read()
        if lane:
            text += LANE_NOTE.format(lane=lane, lead=f"lead-{lane}")
        pane = start_session(name)
        if not pane:
            return 3
        group_session(name, f"lead-{lane}" if lane else NAME)
        herdr("agent", "prompt", name, text)
        os.makedirs(os.path.join(folder, "started"), exist_ok=True)
        os.rename(path, os.path.join(folder, "started", brief))
        print(f"fleet: started {name} in pane {pane}")
    return 0


GROUPS_WARNED = False


def group_session(name, supervisor):
    """Record an explicit assignment when the optional sidebar grouping CLI is installed."""
    global GROUPS_WARNED
    command = shutil.which("herdr-groups")
    if not command:
        if not GROUPS_WARNED:
            GROUPS_WARNED = True
            print("fleet: herdr-groups is not on the PATH, so workers stay ungrouped (docs/setup.md)", file=sys.stderr)
        return False
    try:
        result = subprocess.run([command, "assign", name, supervisor], capture_output=True, text=True, timeout=10)
        if result.returncode:
            print(f"fleet: grouping {name} failed: {result.stderr.strip()}", file=sys.stderr)
        else:
            return True
    except (OSError, subprocess.TimeoutExpired) as error:
        print(f"fleet: grouping {name} failed: {error}", file=sys.stderr)
    return False


class LanesUnreadable(Exception):
    pass


def load_lanes():
    """The lanes in LANES, as [{"id", "name", "about"}]; none if the file is missing. Raises LanesUnreadable."""
    try:
        with open(LANES, encoding="utf-8") as handle:
            lanes = json.load(handle).get("lanes") or []
        iter(lanes)
    except FileNotFoundError:
        return []
    except (OSError, ValueError, AttributeError, TypeError) as error:
        raise LanesUnreadable(f"can't read {LANES}: {error}") from None
    valid = []
    for lane in lanes:
        lane_id = lane.get("id") if isinstance(lane, dict) else None
        if isinstance(lane_id, str) and LANE_ID.fullmatch(lane_id) and lane_id not in RESERVED:
            valid.append(lane)
        else:
            print(f"lanes: skipping {lane!r}: ids are lowercase, up to 27 characters, not {RESERVED}", file=sys.stderr)
    return valid


class JevUnavailable(Exception):
    pass


def typesafe_key(problems=None):
    """TYPESAFE_API_KEY, then jev.api_key in ~/.config/team-floor/config.json, then the file named by
    jev.api_key_file (relative paths start in ~/.config/team-floor), by default ~/.config/typesafe/api-key.
    Returns "" when there's no usable key, and adds what went wrong to `problems`. Keep this identical in
    herdr-orchestrator, herdr-tab and codex/skills/herdr/scripts/herdr-tab.py; tests/test_lanes.py compares them."""
    problems = [] if problems is None else problems
    folder = os.path.expanduser("~/.config/team-floor")
    key = os.environ.get("TYPESAFE_API_KEY", "").strip()
    if not key:
        jev = {}
        try:
            with open(os.path.join(folder, "config.json"), encoding="utf-8") as handle:
                jev = json.load(handle).get("jev", {})
        except FileNotFoundError:
            pass
        except Exception as error:
            problems.append(f"can't read {folder}/config.json ({type(error).__name__})")
        jev = jev if isinstance(jev, dict) else {}
        key = jev.get("api_key") if isinstance(jev.get("api_key"), str) else ""
        key = key.strip()
        named = jev.get("api_key_file")
        custom = isinstance(named, str) and bool(named)
        if named is not None and not custom:
            problems.append("jev.api_key_file in config.json must be a path")
        if not key:
            path = os.path.expanduser("~/.config/typesafe/api-key")
            if custom:
                path = os.path.join(folder, os.path.expanduser(named))
            try:
                with open(path, encoding="utf-8") as handle:
                    key = handle.read().strip()
            except FileNotFoundError:
                if custom:
                    problems.append("the file named by jev.api_key_file doesn't exist")
            except (OSError, ValueError) as error:
                problems.append(f"can't read the TypeSafe key file ({type(error).__name__})")
    if key and (" " in key or not key.isprintable()):
        problems.append("the TypeSafe key has spaces or control characters, so it isn't used")
        return ""
    return key


def ask_jev(brief, lanes):
    """Jev's pick among the lane ids and `unclear`, with its probability. Raises JevUnavailable."""
    problems = []
    key = typesafe_key(problems)
    for problem in problems:
        print(f"herdr-orchestrator: {problem}", file=sys.stderr)
    if not key:
        raise JevUnavailable("; ".join(["no TypeSafe key", *problems]))
    criteria = {
        lane["id"]: " - ".join(filter(None, (lane.get("name"), lane.get("about")))) or lane["id"] for lane in lanes
    }
    criteria[UNCLEAR] = "The brief fits none of these lanes, or several equally"
    body = {
        "state": brief[-JEV_CHARS:],
        "model": "jev-latest",
        "questions": {
            "lane": {
                "type": "choice",
                "instructions": "Which lane of work does this brief belong to?",
                "criteria": criteria,
            }
        },
    }
    request = urllib.request.Request(
        JEV_URL,
        data=json.dumps(body).encode(),
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
    )

    class NoRedirects(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *args):  # following one would send the key wherever it points
            return None

    try:
        with urllib.request.build_opener(NoRedirects).open(request, timeout=4) as response:
            reply = json.load(response)
    except OSError as error:
        raise JevUnavailable(f"{type(error).__name__}: {error}") from None
    except ValueError as error:  # its text can quote the request, key included, so name the type only
        raise JevUnavailable(type(error).__name__) from None
    return read_choice(reply, criteria)


def read_choice(reply, options):
    """The pick and its probability from a Jev reply, or JevUnavailable if the reply has another shape."""
    # Documented: {"answers": {"lane": {"type": "choice", "choice", "confidence", "probabilities": {...}}}}
    try:
        answer = reply["answers"]["lane"]
        choice = answer["choice"]
        # The probability of the pick itself; confidence only if a reply leaves that out.
        probability = float((answer.get("probabilities") or {}).get(choice, answer.get("confidence")))
    except (AttributeError, KeyError, TypeError, ValueError) as error:
        raise JevUnavailable(f"unexpected reply ({type(error).__name__}: {error})") from None
    if not isinstance(choice, str) or choice not in options:
        raise JevUnavailable(f"picked {choice!r}, which isn't a lane")
    if not 0 <= probability <= 1:
        raise JevUnavailable(f"probability {probability} is out of range")
    return choice, probability


def decide(choice, probability):
    """Our rule for Jev's answer: ("route" | "confirm" | "ask", why)."""
    if choice == UNCLEAR:
        return "ask", "Jev said unclear"
    if probability >= ROUTE_AT:
        return "route", f">= {ROUTE_AT:.2f}"
    if probability >= CONFIRM_AT:
        return "confirm", f"{CONFIRM_AT:.2f} to {ROUTE_AT:.2f}, marked lane to confirm"
    return "ask", f"below {CONFIRM_AT:.2f}; Jev leaned {choice}"


def route(path=None):
    if not path:
        print("usage: herdr-orchestrator route <brief>", file=sys.stderr)
        return 2
    if not os.path.isfile(path):
        path = os.path.join(QUEUE, path)
    if not os.path.isfile(path):
        print(f"route: no brief at {path}", file=sys.stderr)
        return 2
    try:
        lanes = load_lanes()
    except LanesUnreadable as error:
        print(f"route: {error}", file=sys.stderr)
        return 2
    if not lanes:
        print(f"route: no lanes in {LANES}", file=sys.stderr)
        return 2
    with open(path, encoding="utf-8") as handle:
        brief = handle.read()
    try:
        choice, probability = ask_jev(brief, lanes)
        rule, why = decide(choice, probability)
    except JevUnavailable as error:  # never block on Jev: Kevin picks instead
        choice, probability, rule, why = None, None, "ask", f"Jev unavailable: {error}"
    shown = "-" if probability is None else f"{probability:.2f}"
    name = os.path.basename(path)
    if rule == "ask":
        print(f"lane: none, probability: {shown}, rule: ask Kevin ({why})")
        subprocess.run([TAB, "ask", f"which lane for {name[: -len('.md')]}?"], check=False)
        print(f"left {path} unrouted")
        return 3
    print(f"lane: {choice}, probability: {shown}, rule: {rule} ({why})")
    lane = next(lane for lane in lanes if lane["id"] == choice)
    with queue_lock():
        # Jev took a while, and `next` may have started the brief meanwhile; it's only ours if it's still here.
        try:
            with open(path, encoding="utf-8") as handle:
                brief = handle.read()
        except FileNotFoundError:
            print(f"route: {path} was started or moved while Jev answered; nothing routed", file=sys.stderr)
            return 1
        if rule == "confirm":
            brief = (
                f"Lane to confirm: Jev put this brief in the {lane.get('name') or choice} lane with probability "
                f"{shown}. Check that it belongs there before you start it.\n\n" + brief
            )
        folder = os.path.join(QUEUE, choice)
        os.makedirs(folder, exist_ok=True)
        target = os.path.join(folder, name)
        if os.path.exists(target):
            print(f"route: {target} already exists; left {path} where it is", file=sys.stderr)
            return 1
        with open(target, "w", encoding="utf-8") as handle:
            handle.write(brief)
        os.remove(path)
        print(f"moved to {target}")
        line, busy = survey(lane)
    print(f"{line}; {start_lead(lane)}" if busy else line)
    return 0


def lane_items(lane_id):
    """A lane's open work: its queued briefs, and the started ones whose session is still open."""
    folder = os.path.join(QUEUE, lane_id)
    queued = [agent_name(brief) for brief in briefs_in(folder)]
    started = [agent_name(brief) for brief in briefs_in(os.path.join(folder, "started"))]
    sessions = []
    if started:  # one look at Herdr, however many briefs the lane has ever started
        agents = {a.get("name"): a for a in herdr("agent", "list")["agents"] if a.get("name")}
        labels = {t["tab_id"]: t.get("label") or "" for t in herdr("tab", "list")["tabs"]}
        for name in started:
            agent = agents.get(name)
            if agent and not any(mark in labels.get(agent.get("tab_id"), "") for mark in FINISHED):
                sessions.append(name)
    return queued, sessions


def lost_lead(lead):
    """A tab that still reads as the lead's and runs an agent, though no agent has the lead's name."""
    label = f"{LEAD} {lead}"
    tabs = {t["tab_id"] for t in herdr("tab", "list")["tabs"] if (t.get("label") or "").endswith(label)}
    if not tabs:
        return None
    return next((p["tab_id"] for p in herdr("pane", "list")["panes"] if p["tab_id"] in tabs and p.get("agent")), None)


def survey(lane):
    """One line about a lane, and whether it needs a lead. Asks a quiet lane's lead, once, to hand it back."""
    lane_id, lead = lane["id"], f"lead-{lane['id']}"
    queued, sessions = lane_items(lane_id)
    count = len(queued) + len(sessions)
    line = f"{lane_id}: {len(queued)} queued, {len(sessions)} open"
    asked = os.path.join(QUEUE, lane_id, ".handback-asked")
    agent = agent_named(lead)
    if not agent:
        return (line, True) if count >= LEAD_AT else (f"{line}; no lead", False)
    if count > HANDBACK_AT:  # busy again: ask afresh the next time it's quiet
        with contextlib.suppress(FileNotFoundError):
            os.remove(asked)
        return f"{line}; {lead} in tab {agent['tab_id']}", False
    if os.path.exists(asked):
        return f"{line}; {lead} asked to hand it back", False
    herdr(
        "agent",
        "prompt",
        lead,
        f"Status from orchestrator: lane {lane_id} is down to {count} open item. Between steps, "
        f"run `~/.claude/hooks/herdr-orchestrator handback {lane_id}`.",
    )
    os.makedirs(os.path.dirname(asked), exist_ok=True)  # a lane that never had a brief has no folder
    open(asked, "w").close()
    return f"{line}; asked {lead} to hand it back", False


def start_lead(lane):
    """Start a busy lane's lead unless it has one; what happened."""
    # Outside the queue lock: starting a session can take minutes, and leads and workers need the queue
    # meanwhile. The lane's own lock keeps two of these from racing.
    lane_id, lead = lane["id"], f"lead-{lane['id']}"
    label = f"{LEAD} {lead}"
    with locked(os.path.join(QUEUE, lane_id), ".lead.lock"):
        if agent_named(lead):
            return f"{lead} is already running"
        stray = lost_lead(lead)
        if stray:
            return f"tab {stray} reads {label} but lost the name, so no second lead starts"
        pane = start_session(lead, label)
        if not pane:
            return f"{lead} waits for memory"
        with contextlib.suppress(FileNotFoundError):
            os.remove(os.path.join(QUEUE, lane_id, ".handback-asked"))
        brief = LEAD_BRIEF.format(
            lead=lead,
            name=lane.get("name") or lane_id,
            about=lane.get("about") or lane.get("name") or lane_id,
            label=label,
            queue=os.path.join(QUEUE, lane_id),
            lane=lane_id,
            handback=HANDBACK_AT,
        )
        herdr("agent", "prompt", lead, brief)
        if group_session(lead, NAME):
            try:
                for session in lane_items(lane_id)[1]:
                    group_session(session, lead)
            except RuntimeError as error:
                print(f"fleet: grouping {lead}'s workers failed: {error}", file=sys.stderr)
    return f"started {lead} in pane {pane}"


def leads():
    try:
        lanes = load_lanes()
    except LanesUnreadable as error:
        print(f"leads: {error}", file=sys.stderr)
        return 2
    if not lanes:
        print(f"no lanes in {LANES}")
        return 0
    with queue_lock():
        surveyed = [(lane, *survey(lane)) for lane in lanes]
    for lane, line, busy in surveyed:
        print(f"{line}; {start_lead(lane)}" if busy else line)
    return 0


def handback(lane_id=None):
    me = os.environ.get("HERDR_PANE_ID")
    if not lane_id or not LANE_ID.fullmatch(lane_id):
        print("usage: herdr-orchestrator handback <lane>", file=sys.stderr)
        return 2
    lead = f"lead-{lane_id}"
    agent = agent_named(lead)
    if not agent or agent["pane_id"] != me:
        print(f"only {lead} hands lane {lane_id} back, from its own pane", file=sys.stderr)
        return 2
    with queue_lock():
        queued, sessions = lane_items(lane_id)
        if len(queued) + len(sessions) > HANDBACK_AT:
            print(f"lane {lane_id} still has {len(queued)} queued and {len(sessions)} open; keep leading it")
            return 1
        # The tab first: a tab that still reads as the lead's, with nobody holding the name, would stop
        # any new lead for the lane. herdr-tab keeps the status and any ask.
        try:
            renamed = subprocess.run([TAB, "name", f"💤 ex-{lead}"], capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired) as error:
            renamed = subprocess.CompletedProcess([], 1, "", str(error))
        if renamed.returncode != 0:
            print(f"couldn't rename this tab, so {lead} keeps the lane: {renamed.stderr.strip()}", file=sys.stderr)
            return 1
        herdr("agent", "rename", me, "--clear")
        with contextlib.suppress(FileNotFoundError):
            os.remove(os.path.join(QUEUE, lane_id, ".handback-asked"))
    type_into(me, f"/rename ex-{lead}")
    left = ", ".join(queued + sessions) or "nothing"
    if live():
        for session in sessions:
            group_session(session, NAME)
        herdr("agent", "prompt", NAME, f"Status from {lead}: handed lane {lane_id} back to you; open: {left}.")
    else:
        print(f"no orchestrator to tell; open in {lane_id}: {left}", file=sys.stderr)
    print(f"handed lane {lane_id} back; this conversation stays open")
    return 0


def main():
    if os.environ.get("HERDR_ENV") != "1":
        print("not running inside Herdr", file=sys.stderr)
        return 2
    command, args = sys.argv[1] if len(sys.argv) > 1 else "who", sys.argv[2:]
    commands = {  # each with the most arguments it takes
        "who": (who, 0),
        "claim": (claim, 0),
        "ensure": (ensure, 0),
        "next": (next_brief, 2),
        "route": (route, 1),
        "leads": (leads, 0),
        "handback": (handback, 1),
    }
    if command not in commands or len(args) > commands[command][1]:
        print(__doc__.strip())
        return 2
    try:
        return commands[command][0](*args)
    except RuntimeError as error:  # a failed herdr call: report it in a line, not a traceback
        print(f"herdr-orchestrator {command}: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
